{
  "presets": [
    ["@babel/preset-env", {
      "modules": false
    }]
  ],
  "plugins": [
    ["@babel/transform-runtime", {
      "useESModules": true
    }]
  ],
  "env": {
    "cjs": {
      "presets": [
        "@babel/preset-env"
      ],
      "plugins": [
        "@babel/transform-runtime"
      ]
    },
    "test": {
      "presets": [
        "@babel/preset-env"
      ],
      "plugins": [
        "@babel/transform-runtime"
      ]
    }
  }
}
