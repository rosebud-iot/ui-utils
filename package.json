{
  "name": "ui-utils",
  "version": "2.8.6",
  "description": "Utility library for browsers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "type": "commonjs",
  "peerDependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/register": "^7.27.1",
    "chai": "^4.3.7",
    "mocha": "^11.7.1",
    "sinon": "^15.0.3"
  },
  "scripts": {
    "test": "NODE_ENV=test mocha --require @babel/register",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "BABEL_ENV=cjs npx babel src -d dist --minified --no-comments",
    "build:esm": "BABEL_ENV=esm npx babel src -d dist --out-file-extension .mjs --minified --no-comments"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosebud-iot/ui-utils.git"
  },
  "keywords": [
    "utility"
  ],
  "author": "André Drougge",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rosebud-iot/ui-utils/issues"
  },
  "homepage": "https://github.com/rosebud-iot/ui-utils#readme",
  "dependencies": {
    "@babel/runtime": "^7.27.6"
  }
}
